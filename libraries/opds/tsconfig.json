{
  "extends": ["@tsconfig/strictest/tsconfig.json"],
  "compilerOptions": {
    // tsgolint (Oxlint's type-aware engine) does not auto-include
    // @types packages the way tsc does, so list them explicitly.
    "types": ["node"],
    "composite": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "module": "NodeNext",
    "target": "esnext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ESNext"],
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "outDir": "dist",
    "customConditions": ["@storyteller"],
    "resolveJsonModule": true,
    "exactOptionalPropertyTypes": false
  },
  "include": ["./**/*.ts", "schemas/**/*.schema.json"],
  "exclude": [
    "dist",
    "schemas/sync.ts",
    "schemas/ajv/compile.ts",
    "schemas/ajv/standalone.cjs"
  ],
  "references": [
    {
      "path": "../media-types"
    }
  ]
}
