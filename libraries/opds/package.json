{
  "name": "@storyteller-platform/opds",
  "description": "A library for generating, validating, and parsing OPDS 2.0 catalog feeds, compatible with @readium/shared.",
  "keywords": [
    "opds",
    "opds-2",
    "readium",
    "rwp"
  ],
  "version": "0.1.0",
  "type": "module",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./validate": {
      "types": "./validate/index.ts",
      "default": "./validate/index.ts"
    },
    "./validate/ajv": {
      "types": "./schemas/ajv/validate.ts",
      "default": "./schemas/ajv/validate.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rm -rf dist .tsbuild && tsc -b tsconfig.build.json && mkdir -p dist/schemas/ajv && cp schemas/ajv/standalone.cjs dist/schemas/ajv/standalone.cjs",
    "schemas:sync": "tsx schemas/sync.ts && tsx schemas/ajv/compile.ts",
    "readme:toc": "markdown-toc --maxdepth=5 --append='\n- [API Docs](#api-docs)' --bullets='-' -i readme-stub.md",
    "readme:api": "typedoc",
    "readme": "yarn readme:api && yarn readme:toc && cat readme-stub.md > README.md && tail -n +2 gen/README.md >> README.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.9.3",
    "@tsconfig/strictest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@^7.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-xml-validator": "^1.4.2",
    "json-schema-to-typescript": "^15.0.0",
    "markdown-toc": "catalog:",
    "remark-toc": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-plugin-remark": "catalog:",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@readium/shared": "*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    },
    "ajv-formats": {
      "optional": true
    }
  },
  "dependencies": {
    "@storyteller-platform/media-types": "workspace:^",
    "fast-xml-builder": "^1.3.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./validate": {
        "types": "./dist/validate/index.d.ts",
        "default": "./dist/validate/index.js"
      },
      "./validate/ajv": {
        "types": "./dist/schemas/ajv/validate.d.ts",
        "default": "./dist/schemas/ajv/validate.js"
      }
    }
  }
}
