{
  "name": "@storyteller-platform/crengine-xpointer",
  "description": "Resolve and build koreader/crengine \"xpointers\" against an @xmldom/xmldom tree",
  "keywords": [
    "crengine",
    "koreader",
    "epub",
    "xpointer",
    "xml",
    "xmldom"
  ],
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/storyteller-platform/storyteller"
  },
  "author": "Shane Friedman",
  "type": "module",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "exports": {
    "types": "./src/index.ts",
    "default": "./src/index.ts"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rm -rf dist .tsbuild && tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@xmldom/xmldom": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/strictest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
