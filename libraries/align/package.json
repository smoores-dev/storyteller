{
  "name": "@storyteller-platform/align",
  "version": "0.2.14",
  "description": "A library and CLI for automatically aligning audiobooks and EPUBs to produce Media Overlays",
  "author": "Shane Friedman",
  "license": "MIT",
  "keywords": [
    "epub",
    "ebook",
    "speech-to-text",
    "audiobook"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/storyteller-platform/storyteller"
  },
  "bugs": {
    "url": "https://gitlab.com/storyteller-platform/storyteller"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "type": "module",
  "files": [
    "dist",
    "prebuilds",
    "binding.gyp",
    "README.md",
    "LICENSE.txt"
  ],
  "exports": {
    ".": {
      "@storyteller": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./readium": {
      "@storyteller": "./src/readium/index.ts",
      "types": "./src/readium/index.ts",
      "default": "./dist/readium/index.js"
    },
    "./report": {
      "@storyteller": "./src/align/report-v4.ts",
      "types": "./src/align/report-v4.ts",
      "default": "./dist/align/report-v4.js"
    },
    "./exclusions": {
      "@storyteller": "./src/align/ctc/exclusions.ts",
      "types": "./src/align/ctc/exclusions.ts",
      "default": "./dist/align/ctc/exclusions.js"
    },
    "./emissions": {
      "@storyteller": "./src/align/ctc/emissions.ts",
      "types": "./src/align/ctc/emissions.ts",
      "default": "./dist/align/ctc/emissions.js"
    }
  },
  "scripts": {
    "compile": "NODE_OPTIONS=--experimental-import-meta-resolve ./scripts/bundle.js && node --build-sea sea-config.json",
    "build": "rm -rf dist .tsbuild && tsc -b tsconfig.build.json",
    "install": "node-gyp-build",
    "prepack": "yarn build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "bin": "./dist/cli/bin.js",
  "dependencies": {
    "@echogarden/icu-segmentation-wasm": "^0.2.2",
    "@echogarden/text-segmentation": "^0.4.1",
    "@esfx/async-semaphore": "catalog:",
    "@optique/core": "^1.3.2",
    "@optique/run": "^1.3.2",
    "@readium/shared": "catalog:",
    "@storyteller-platform/audiobook": "workspace:^",
    "@storyteller-platform/epub": "workspace:^",
    "@storyteller-platform/fs": "workspace:^",
    "@storyteller-platform/ghost-story": "workspace:^",
    "@storyteller-platform/mapping": "workspace:*",
    "@storyteller-platform/media-types": "workspace:^",
    "@storyteller-platform/transliteration": "^4.0.6",
    "cli-progress": "catalog:",
    "esbuild": "catalog:",
    "fastest-levenshtein": "^1.0.16",
    "itertools": "^2.6.0",
    "kuromoji": "0.1.2",
    "locale-currency": "^1.0.0",
    "memoize": "catalog:",
    "node-gyp-build": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "runes2": "^1.1.4",
    "smil-clockvalue": "^0.0.1",
    "to-words": "^5.3.0",
    "yazl": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/strictest": "catalog:",
    "@types/cli-progress": "catalog:",
    "@types/node": "catalog:",
    "@types/yazl": "catalog:",
    "node-addon-api": "^8.3.1",
    "node-gyp": "^11.2.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./readium": {
        "types": "./dist/readium/index.d.ts",
        "default": "./dist/readium/index.js"
      },
      "./report": {
        "types": "./dist/align/report-v4.d.ts",
        "default": "./dist/align/report-v4.js"
      },
      "./exclusions": {
        "types": "./dist/align/ctc/exclusions.d.ts",
        "default": "./dist/align/ctc/exclusions.js"
      },
      "./emissions": {
        "types": "./dist/align/ctc/emissions.d.ts",
        "default": "./dist/align/ctc/emissions.js"
      }
    }
  }
}
