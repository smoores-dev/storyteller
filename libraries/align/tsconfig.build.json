{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "emitDeclarationOnly": false,
    "declaration": true,
    "allowImportingTsExtensions": false,
    "rootDir": "src",
    "tsBuildInfoFile": ".tsbuild/tsconfig.build.tsbuildinfo",
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/align/opencc/TSCharacters.json"
  ],
  "exclude": ["dist", "src/**/__tests__"],
  "references": [
    { "path": "../epub" },
    { "path": "../audiobook" },
    { "path": "../ghost-story" },
    { "path": "../media-types" }
  ]
}
