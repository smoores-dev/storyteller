{
  "extends": ["@tsconfig/strictest/tsconfig.json"],
  "compilerOptions": {
    // tsgolint (Oxlint's type-aware engine) does not auto-include
    // @types packages the way tsc does, so list them explicitly.
    "types": ["node"],
    "composite": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "module": "NodeNext",
    "target": "esnext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ESNext"],
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo",
    "outDir": ".tsbuild/types",
    "customConditions": ["@storyteller"],
    "resolveJsonModule": true,
    "exactOptionalPropertyTypes": false
  },
  "include": ["./**/*.ts"],
  "exclude": ["dist"]
}
