{
  "name": "@storyteller-platform/media-types",
  "description": "An isomorphic, dependency-free table of the file extensions and media types Storyteller understands.",
  "keywords": [
    "media-type",
    "mime",
    "audio",
    "epub"
  ],
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/storyteller-platform/storyteller"
  },
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./table.json": "./table.json"
  },
  "files": [
    "dist/",
    "table.json"
  ],
  "scripts": {
    "build": "yarn generate:json && tsup",
    "generate:json": "tsx -C @storyteller generate-json.ts",
    "check:browser": "esbuild index.ts --bundle --platform=browser --format=esm --outfile=/dev/null",
    "test": "tsx -C @storyteller --test \"**/*.test.ts\"",
    "test:watch": "tsx -C @storyteller --test --watch \"**/*.test.ts\"",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@storyteller-platform/path": "workspace:*"
  },
  "devDependencies": {
    "@storyteller-platform/eslint": "workspace:*",
    "@storyteller-platform/tsup": "workspace:^",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^8.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "@storyteller": "./index.ts",
        "@storyteller-node": "./index.ts",
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./table.json": "./table.json"
    }
  }
}
