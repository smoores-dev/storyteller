{
  "name": "@storyteller-platform/media-types",
  "description": "An isomorphic, dependency-free table of the file extensions and media types Storyteller understands.",
  "keywords": [
    "media-type",
    "mime",
    "audio",
    "epub"
  ],
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/storyteller-platform/storyteller"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "Thomas F. K. Jorna <hello@tefkah.com>",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./table.json": "./table.json"
  },
  "files": [
    "dist/",
    "table.json"
  ],
  "scripts": {
    "build": "rm -rf dist .tsbuild && yarn generate:json && tsc -b tsconfig.build.json",
    "generate:json": "tsx -C @storyteller generate-json.ts",
    "check:browser": "esbuild index.ts --bundle --platform=browser --format=esm --outfile=/dev/null",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@storyteller-platform/path": "workspace:^"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./table.json": "./table.json"
    }
  }
}
