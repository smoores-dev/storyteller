{
  "name": "@storyteller-platform/ghost-story",
  "version": "0.1.16-experimental.0",
  "description": "An easy-to-use speech toolset. Fork of the original echogarden project.",
  "author": "Thomas F. K. Jorna",
  "license": "GPL-3.0",
  "keywords": [
    "speech-to-text"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/storyteller-platform/storyteller"
  },
  "bugs": {
    "url": "https://gitlab.com/storyteller-platform/storyteller/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./recognition": "./src/api/Recognition.ts",
    "./vad": "./src/api/VoiceActivityDetection.ts",
    "./server": "./src/cli/whisper-server.ts",
    "./emission-server": "./src/server/emissionServer.ts",
    "./bin": "./src/cli/bin.ts",
    "./constants": "./src/constants.ts"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuild && tsc -b tsconfig.build.json",
    "prepack": "yarn build",
    "upload-ctc-model": "node scripts/upload-ctc-model.mjs",
    "test": "tsx -C @storyteller --test test/whisper-server.test.ts &&  tsx -C @storyteller --test test/whispercpp.test.ts &&  tsx -C @storyteller --test test/vad.test.ts &&  tsx -C @storyteller --test test/model-packages.test.ts &&  yarn test:emission-server",
    "test:emission-server": "tsx -C @storyteller --test test/emission-server.test.ts"
  },
  "bin": "./dist/cli/bin.js",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.994.0",
    "@aws-sdk/client-transcribe": "^3.994.0",
    "@hono/node-server": "^2.1.1",
    "@huggingface/hub": "^2.17.0",
    "@huggingface/transformers": "^4.2.0",
    "@robingenz/zli": "^0.2.0",
    "@storyteller-platform/fs": "workspace:^",
    "@storyteller-platform/media-types": "workspace:^",
    "chalk": "^5.4.1",
    "cli-progress": "^3.12.0",
    "ffmpeg-stream": "^1.0.1",
    "fs-extra": "~11.3.0",
    "hono": "^4.13.5",
    "lodash.merge": "^4.6.2",
    "microsoft-cognitiveservices-speech-sdk": "~1.44.0",
    "onnxruntime-node": "^1.29.0",
    "openai": "~4.103.0",
    "tar": "^7.4.3",
    "undici": "7.14.0",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "@storyteller-platform/mlx-audio": "workspace:^"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.5",
    "@types/cli-progress": "^3",
    "@types/fs-extra": "~11.0.4",
    "@types/lodash.merge": "^4",
    "@types/node": "^24.0.0",
    "@types/tar": "^6.1.13",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/cli/whisper-server.d.ts",
        "default": "./dist/cli/whisper-server.js"
      },
      "./emission-server": {
        "import": {
          "types": "./dist/server/emissionServer.d.ts",
          "default": "./dist/server/emissionServer.js"
        },
        "require": {
          "types": "./dist/server/emissionServer.d.cts",
          "default": "./dist/server/emissionServer.cjs"
        }
      },
      "./recognition": {
        "types": "./dist/api/Recognition.d.ts",
        "default": "./dist/api/Recognition.js"
      },
      "./vad": {
        "types": "./dist/api/VoiceActivityDetection.d.ts",
        "default": "./dist/api/VoiceActivityDetection.js"
      },
      "./constants": {
        "types": "./dist/constants.d.ts",
        "default": "./dist/constants.js"
      }
    }
  }
}
