{
  "name": "@storyteller-platform/ghost-story",
  "version": "0.2.1",
  "description": "An easy-to-use speech toolset. Fork of the original echogarden project.",
  "author": "Thomas F. K. Jorna",
  "license": "GPL-3.0",
  "keywords": [
    "speech-to-text"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/storyteller-platform/storyteller"
  },
  "bugs": {
    "url": "https://gitlab.com/storyteller-platform/storyteller/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./recognition": "./src/api/Recognition.ts",
    "./vad": "./src/api/VoiceActivityDetection.ts",
    "./server": "./src/cli/whisper-server.ts",
    "./http-server": "./src/server/index.ts",
    "./emission-client": "./src/emission/CtcServerClient.ts",
    "./emission-encoding": "./src/emission/encoding.ts",
    "./bin": "./src/cli/bin.ts",
    "./constants": "./src/constants.ts"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuild && tsc -b tsconfig.build.json",
    "prepack": "yarn build",
    "upload-ctc-model": "node scripts/upload-ctc-model.mjs",
    "test": "vitest run test/whisper-server.test.ts test/whispercpp.test.ts test/vad.test.ts test/model-packages.test.ts",
    "test:emission-server": "vitest run test/emission-server.test.ts",
    "openapi": "vitest run test/openapi.test.ts --update"
  },
  "bin": "./dist/cli/bin.js",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.994.0",
    "@aws-sdk/client-transcribe": "^3.994.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.7.6",
    "@huggingface/transformers": "^4.3.0",
    "@robingenz/zli": "^0.2.0",
    "@storyteller-platform/fs": "workspace:^",
    "@storyteller-platform/media-types": "workspace:^",
    "chalk": "catalog:",
    "cli-progress": "catalog:",
    "ffmpeg-stream": "^1.0.1",
    "fs-extra": "~11.3.0",
    "hono": "^4.13.5",
    "hono-zod-openapi": "^1.1.1",
    "lodash.merge": "^4.6.2",
    "microsoft-cognitiveservices-speech-sdk": "~1.44.0",
    "onnxruntime-node": "catalog:",
    "openai": "~4.103.0",
    "p-queue": "^9.3.3",
    "tar": "^7.4.3",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "@storyteller-platform/mlx-audio": "workspace:^"
  },
  "devDependencies": {
    "@tsconfig/strictest": "catalog:",
    "@types/cli-progress": "catalog:",
    "@types/fs-extra": "~11.0.4",
    "@types/lodash.merge": "^4",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/cli/whisper-server.d.ts",
        "default": "./dist/cli/whisper-server.js"
      },
      "./emission-encoding": {
        "types": "./dist/emission/encoding.d.ts",
        "default": "./dist/emission/encoding.js"
      },
      "./http-server": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "./emission-client": {
        "types": "./dist/emission/CtcServerClient.d.ts",
        "default": "./dist/emission/CtcServerClient.js"
      },
      "./recognition": {
        "types": "./dist/api/Recognition.d.ts",
        "default": "./dist/api/Recognition.js"
      },
      "./vad": {
        "types": "./dist/api/VoiceActivityDetection.d.ts",
        "default": "./dist/api/VoiceActivityDetection.js"
      },
      "./constants": {
        "types": "./dist/constants.d.ts",
        "default": "./dist/constants.js"
      }
    }
  }
}
