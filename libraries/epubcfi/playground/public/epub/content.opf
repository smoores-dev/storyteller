<?xml version="1.0" encoding="UTF-8" ?>
<package version="2.0"
            xmlns="http://www.idpf.org/2007/opf"
            xmlns:dc="http://purl.org/dc/elements/1.1/"
            xmlns:opf="http://www.idpf.org/2007/opf">
    <metadata></metadata>
    <manifest>
        <item id="abstract-item"
                href="abstract.xhtml"
                media-type="application/xhtml+xml"/>
    </manifest>
    <spine>
        <itemref id="abstract"
             idref="abstract-item" />
    </spine>
</package>
