{
  "name": "@storyteller-platform/epub",
  "version": "0.8.1",
  "type": "module",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./node.ts",
      "default": "./index.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rm -rf dist .tsbuild && tsc -b tsconfig.build.json",
    "readme:toc": "markdown-toc --maxdepth=5 --append='\n- [API Docs](#api-docs)' --bullets='-' -i readme-stub.md",
    "readme:api": "typedoc",
    "readme": "yarn readme:api && yarn readme:toc && cat readme-stub.md > README.md && tail -n +2 gen/README.md >> README.md",
    "install-epubcheck": "tsx scripts/install-epubcheck.ts",
    "test": "yarn install-epubcheck && vitest run",
    "test:watch": "yarn install-epubcheck && vitest",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^24.0.0",
    "@types/yauzl-promise": "^4",
    "@types/yazl": "^3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "markdown-toc": "^1.2.0",
    "remark-toc": "^9.0.0",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.6.3",
    "typedoc-plugin-remark": "^1.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@readium/shared": "^2.2.0",
    "@storyteller-platform/fs": "workspace:^",
    "@storyteller-platform/media-types": "workspace:^",
    "@storyteller-platform/path": "workspace:^",
    "@zip.js/zip.js": "^2.0.0",
    "async-mutex": "^0.5.0",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.1",
    "mem": "^8.0.0",
    "nanoid": "^5.1.5",
    "yauzl-promise": "^4.0.0",
    "yazl": "^3.3.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
