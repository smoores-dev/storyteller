{
  "extends": ["@tsconfig/strictest/tsconfig.json"],
  "compilerOptions": {
    // tsgolint (Oxlint's type-aware engine) does not auto-include
    // @types packages the way tsc does, so list them explicitly.
    "types": ["node"],
    "composite": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ESNext"],
    // Enables the jsx-runtime for XML element creation.
    // The actual pragma is defined per-file so that it
    // doesn't interfere with React applications that
    // depend on this lib.
    "jsx": "react-jsx",
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo",
    "outDir": ".tsbuild/types",
    "customConditions": ["@storyteller"]
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["dist"],
  "references": [
    {
      "path": "../fs"
    },
    {
      "path": "../path"
    },
    {
      "path": "../media-types"
    }
  ]
}
