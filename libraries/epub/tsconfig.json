{
  "extends": ["@tsconfig/strictest/tsconfig.json"],
  "compilerOptions": {
    // tsgolint (Oxlint's type-aware engine) does not auto-include
    // @types packages the way tsc does, so list them explicitly.
    "types": ["node"],
    "composite": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ESNext"],
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "outDir": "dist",
    "customConditions": ["@storyteller"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["dist"],
  "references": [
    {
      "path": "../fs"
    },
    {
      "path": "../path"
    },
    {
      "path": "../media-types"
    }
  ]
}
