{
  "name": "@storyteller-platform/mapping",
  "description": "A library for mapping character offsets between pre- and post-transformed strings.",
  "keywords": [
    "mapping",
    "text",
    "transformation",
    "strings"
  ],
  "version": "0.1.3",
  "type": "module",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "Shane Friedman",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rm -rf dist .tsbuild && tsc -b tsconfig.build.json",
    "test": "tsx -C @storyteller --test \"**/*.test.ts\"",
    "test:watch": "tsx -C @storyteller --test --watch \"**/*.test.ts\"",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
