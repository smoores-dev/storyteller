{
  "name": "@storyteller-platform/mapping",
  "description": "A library for mapping character offsets between pre- and post-transformed strings.",
  "keywords": [
    "mapping",
    "text",
    "transformation",
    "strings"
  ],
  "version": "0.2.0",
  "type": "module",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "Shane Friedman",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rm -rf dist .tsbuild && tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@tsconfig/strictest": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
