{
  "name": "@storyteller-platform/audiobook",
  "version": "0.5.1",
  "type": "module",
  "license": "MIT",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rm -rf dist .tsbuild && tsc -b tsconfig.build.json",
    "readme:toc": "markdown-toc --maxdepth=5 --append='\n- [API Docs](#api-docs)' --bullets='-' -i readme-stub.md",
    "readme:api": "typedoc",
    "readme": "yarn readme:api && yarn readme:toc && cat readme-stub.md > README.md && tail -n +2 gen/node.md >> README.md && tail -n +2 gen/entry.md >> README.md && tail -n +2 gen/base.md >> README.md && tail -n +2 gen/node/entry.md >> README.md",
    "test": "rm -rf src/__fixtures__/__output__ && vitest run",
    "test:watch": "vitest",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.5",
    "@types/yauzl-promise": "^4",
    "@types/yazl": "^3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "markdown-toc": "^1.2.0",
    "remark-toc": "^9.0.0",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.6.3",
    "typedoc-plugin-remark": "^1.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@storyteller-platform/fs": "workspace:^",
    "@storyteller-platform/media-types": "workspace:^",
    "@storyteller-platform/path": "workspace:^",
    "@types/node": "^24.0.0",
    "music-metadata": "^11.9.0",
    "yauzl-promise": "^4.0.0",
    "yazl": "^3.3.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
