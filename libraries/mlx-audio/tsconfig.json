{
  "extends": ["@tsconfig/strictest/tsconfig.json"],
  "compilerOptions": {
    // tsgolint (Oxlint's type-aware engine) does not auto-include
    // @types packages the way tsc does, so list them explicitly.
    "types": ["node"],
    "composite": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "lib": ["esnext"],
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo",
    "outDir": ".tsbuild/types",
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types",
      "../../types"
    ]
  },
  "include": ["src/**/*.ts"]
}
