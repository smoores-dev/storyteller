{
  "name": "@storyteller-platform/nodekit",
  "version": "0.2.0",
  "description": "Cross-platform native loader and typed wrapper for StorytellerNodeKit",
  "license": "MIT",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "napi": {
    "binaryName": "nodekit",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      }
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@^7.0.2",
    "markdown-toc": "catalog:",
    "remark-toc": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-plugin-remark": "catalog:",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "rm -rf dist .tsbuild && tsc -b tsconfig.build.json",
    "build:native": "../../applications/clients/scripts/nodebuild",
    "build:native:debug": "../../applications/clients/scripts/nodebuild --debug",
    "load-test": "node scripts/load-test.mjs",
    "pack-local": "node scripts/pack-local.mjs",
    "prepack": "yarn build",
    "prepublish": "napi prepublish -t npm",
    "readme:toc": "markdown-toc --maxdepth=5 --append='\n- [API Docs](#api-docs)' --bullets='-' -i readme-stub.md",
    "readme:api": "typedoc",
    "readme": "yarn readme:api && yarn readme:toc && cat readme-stub.md > README.md && tail -n +2 gen/README.md >> README.md",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
