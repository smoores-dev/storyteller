{ pkgs, ... }:

let
  patched-whisper = (pkgs.whisper-cpp.override {
    vulkanSupport = true; # you cant compile for both cuda&rocm at once, but vulkan supports both and is only ~10-20% slower
  }).overrideAttrs (finalAttrs: oldAttrs: {
    version = "1.8.3";
    src = pkgs.fetchFromGitHub {
      owner = "ggml-org";
      repo = "whisper.cpp";
      tag = "v${finalAttrs.version}";
      hash = "sha256-TeS1lGKEzkHOoBemy/tMGtIsy0iouj9DTYIgTjUNcQk=";
    };
    patches = (oldAttrs.patches or []) ++ [
      ./scripts/whisper-server-config.patch
      ./scripts/whisper-sycl-compat-fix.patch
      ./scripts/whisper-utf8-json-fix.patch
    ];
  });
in
{
  packages = with pkgs; [
    ffmpeg
    # Order is important here — we need sqlite-interactive's
    # sqlite3 executable to come first in the path,
    # but we also want the development headers, which are
    # in the sqlite package.
    sqlite-interactive
    sqlite
    git-lfs
    vtsls
    google-cloud-sdk
    gcc
  ] ++ [
    # https://github.com/NixOS/nixpkgs/pull/546525
    (pkgs.buildGoModule (finalAttrs: {
      pname = "readium";
      version = "0.6.5";
      __structuredAttrs = true;
      src = pkgs.fetchFromGitHub {
        owner = "readium";
        repo = "cli";
        tag = "v${finalAttrs.version}";
        hash = "sha256-z6z4CYM/zlm0mmMRSDgCmr1Kq7XSz228vuwvgquFnVk=";
      };
      vendorHash = "sha256-o4vUwITfdxsHEDgd6uGOkMZ96r51pdG8KO97Kge7K1w=";
      postInstall = "mv $out/bin/cmd $out/bin/readium";
    }))
    patched-whisper
  ];
  env.WHISPER_CPP_PATH = "${patched-whisper}";

  languages.javascript = {
    enable = true;
    package = pkgs.nodejs_24;
    corepack.enable = true;
  };

  tasks."repo:init" = {
    description = "Do necessary work for setting up development";
    exec = ''
      yarn install
      git lfs pull
      touch .devenv-initialized'';
    status = "test -f .devenv-initialized";
    before = [
      "devenv:enterShell"
      "devenv:enterTest"
    ];
  };

  devcontainer.enable = true;
  devcontainer.settings._COMMENT1 = "This file is auto-generated by devenv.nix";
  devcontainer.settings._COMMENT2 = "It gets overwritten by devenv and the devcontainer.";
  devcontainer.settings.customizations.vscode.extensions = [
    # Default; needed to make devenv devcontainer work
    "mkhl.direnv"
    # Copied from .vscode/extensions.json
    "arcanis.vscode-zipfs"
    "dbaeumer.vscode-eslint"
    "esbenp.prettier-vscode"
    "ms-python.python"
    "ms-python.vscode-pylance"
    "ms-azuretools.vscode-docker"
    "ms-python.black-formatter"
    "bbenoist.nix"
    "gitlab.gitlab-workflow"
    "redhat.vscode-yaml"
  ];
  devcontainer.settings.updateContentCommand = ''
    direnv allow
    mkdir -p ~/.local/share/nix/
    echo -n '{"extra-substituters":{"https://devenv.cachix.org":true},"extra-trusted-public-keys":{"devenv.cachix.org-1:w1cLUi8dv3hnoSPGAuibQv+f9TZLr6cv/Hm9XgU50cw=":true}}' > ~/.local/share/nix/trusted-settings.json
    DIRENV_WARN_TIMEOUT=0 direnv exec ''${containerWorkspaceFolder} devenv test'';
  devcontainer.settings.containerEnv = {
    DEV_CONTAINER = "true";
  };

  enterTest = "yarn check";
}
