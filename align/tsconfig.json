{
  "extends": ["@tsconfig/strictest/tsconfig.json"],
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "lib": ["esnext"],
    "outDir": "dist"
  },
  "include": [
    "package.json",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "./src/types/smil-clockvalue.d.ts"
  ],
  "references": [
    {
      "path": "../epub"
    },
    {
      "path": "../audiobook"
    },
    {
      "path": "../ghost-story"
    }
  ]
}
