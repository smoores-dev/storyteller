{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storyteller Server",
  "version": "../package.json",
  "identifier": "dev.storyteller-platform.tauri",
  "build": {
    "frontendDist": "../splash",
    "devUrl": "http://localhost:8001"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Storyteller Server",
        "url": "/",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        // "decorations": false,
        "windowEffects": {
          "effects": [],
          "radius": 50
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/runtime.tar.gz", "resources/runtime-id"],
    "externalBin": [
      "binaries/node",
      "binaries/readium",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0MEQyRkIzNzUwRjkwQzgKUldUSWtBOTFzeThOUkNRNjhERmo3RWcySlQvWExqM3o3aUR1SDJZbjlDa1FyaEthNmtFUTlqZmMK",
      "endpoints": [
        "https://gitlab.com/api/v4/projects/67994333/packages/generic/storyteller-tauri/latest/latest.json"
      ]
    }
  }
}
