{
  "name": "@storyteller-platform/web",
  "version": "2.14.21",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "dotenvx run --env-file=.env.local -- tsx -C @storyteller-node src/database/migrate.ts",
    "db:migrate:reset": "cp ${STORYTELLER_DATA_DIR}/storyteller.db ${STORYTELLER_DATA_DIR}/test.db",
    "db:migrate:test": "dotenvx run --env-file=.env.local -- yarn db:migrate:reset && STORYTELLER_DB_FILENAME=test.db yarn db:migrate",
    "db:migrate:apply": "dotenvx run --env-file=.env.local -- tsx -C @storyteller-node scripts/manip-migrations.ts apply",
    "db:migrate:unapply": "dotenvx run --env-file=.env.local -- tsx -C @storyteller-node scripts/manip-migrations.ts unapply",
    "db:dump": "STORYTELLER_TEST_DB=1 STORYTELLER_SECRET_KEY=schema-dump-key tsx -C @storyteller-node scripts/dump-db.ts",
    "dev": "yarn dev:worker && yarn dev:file-write-worker && STORYTELLER_WORKER=worker.js STORYTELLER_FILE_WRITE_WORKER=fileWriteWorker.js PORT=${PORT:-8001} next dev --turbo",
    "dev:worker": "esbuild src/work/worker.ts --bundle --platform=node --packages=external --sourcemap=inline --format=esm --outdir=work-dist/",
    "dev:file-write-worker": "esbuild src/writeToFiles/fileWriteWorker.ts --bundle --platform=node --packages=external --sourcemap=inline --format=esm --outdir=file-write-dist/",
    "bench:grid": "tsx scripts/grid-bench/run.ts",
    "test": "STORYTELLER_DATA_DIR=src/__fixtures__/__output__ STORYTELLER_TEST_DB=1 STORYTELLER_SECRET_KEY=test-secret-key tsx -C @storyteller-node --test",
    "test:watch": "STORYTELLER_DATA_DIR=src/__fixtures__/__output__ STORYTELLER_TEST_DB=1 STORYTELLER_SECRET_KEY=test-secret-key tsx -C @storyteller-node --test --watch",
    "test:all": "STORYTELLER_DATA_DIR=src/__fixtures__/__output__ STORYTELLER_TEST_DB=1 STORYTELLER_SECRET_KEY=test-secret-key tsx -C @storyteller-node --test src/__tests__/*.test.ts src/*/__tests__/*.test.ts",
    "build": "yarn build:worker && yarn build:file-write-worker && next build",
    "build:worker": "esbuild src/work/worker.ts --conditions=@storyteller-node --bundle --platform=node --loader:.node=file --sources-content=false --sourcemap --format=esm --splitting --external:winax --external:@parcel --external:@reflink --external:@node-rs/xxhash --external:@node-rs/crc32 --external:@storyteller-platform/okmain --external:better-sqlite3 --external:onnxruntime-node --external:@huggingface/transformers --external:sharp --out-extension:.js=.mjs --banner:js='import{createRequire}from\"node:module\";const require=createRequire(import.meta.url);' --outdir=work-dist/",
    "build:file-write-worker": "esbuild src/writeToFiles/fileWriteWorker.ts --conditions=@storyteller-node --bundle --platform=node --loader:.node=file --sources-content=false --sourcemap --format=esm --splitting --external:winax --external:@parcel --external:@node-rs/xxhash --external:@node-rs/crc32 --external:@reflink --external:@storyteller-platform/okmain --external:better-sqlite3 --external:onnxruntime-node --external:@huggingface/transformers --external:sharp --out-extension:.js=.mjs --banner:js='import{createRequire}from\"node:module\";const require=createRequire(import.meta.url);' --outdir=file-write-dist/",
    "start": "./start.sh"
  },
