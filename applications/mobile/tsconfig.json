{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "allowImportingTsExtensions": true,
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types",
      "../../types"
    ]
  },
  "extends": ["expo/tsconfig.base", "@tsconfig/strictest"],
  "exclude": ["babel.config.js", "metro.config.js", "ios", "android"],
  "references": [
    {
      "path": "../web"
    },
    {
      "path": "../../libraries/audiobook"
    },
    {
      "path": "../../libraries/epub"
    },
    {
      "path": "../../libraries/path"
    },
    {
      "path": "../../libraries/fs"
    },
    {
      "path": "../../libraries/align"
    }
  ]
}
