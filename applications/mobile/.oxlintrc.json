{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../../.oxlintrc.json",
    "../../config/oxlint/react-recommended.json",
    "../../config/oxlint/typescript-recommended.json"
  ],
  "ignorePatterns": [
    "**/.*",
    "**/dist",
    "**/node_modules",
    "tsbuild",
    "/android",
    "/ios"
  ],
  "rules": {
    "react-compiler/react-compiler": "error",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "import-alias/prefer-alias": [
          "error",
          {
            "alias": { "@": "./applications/mobile" },
            "aliasForSubpaths": true
          }
        ]
      }
    }
  ]
}
