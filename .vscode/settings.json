{
  "search.exclude": {
    "**/.yarn": true,
    "**/.pnp.*": true
  },
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "oxc.enable.oxlint": true,
  "oxc.enable.oxfmt": true,
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "cmake.configureOnOpen": false,
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  },
  "tailwindCSS.experimental.configFile": "../applications/web/src/app/(v3)/v3/globals.css",
  "i18n-ally.localesPaths": ["./web/messages"],
  "i18n-ally.keystyle": "nested",
  "python.defaultInterpreterPath": "${workspaceFolder}/libraries/mlx-audio/scripts/.venv/bin/python"
}
